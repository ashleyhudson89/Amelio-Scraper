# Render service
PORT=3000
# Set to a random string. n8n workflows must send this in the X-Auth header.
RENDER_AUTH_TOKEN=change-me-to-a-long-random-string

# These are used by n8n, NOT by the render service.
# Listed here so you have one place to track every credential.
# n8n stores its own copies once configured.
OPENAI_API_KEY=
ODDS_API_KEY=
IG_USER_ID=
IG_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
